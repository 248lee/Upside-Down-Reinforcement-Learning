{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "--batch_size=256",
                "--gamma=0.9982644237747148",
                "--learning_rate=0.00015252076249820857",
                "--n_rollout_steps_per_iter_add=8",
                "--ovn_update_rate=0.00197974557334536",
                "--replay_size=100000",
                "--return_scale=0.016118113748483247"
            ],
        }
    ]
}